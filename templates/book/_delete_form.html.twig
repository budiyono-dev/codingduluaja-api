<form method="post" action="{{ path('app_book_delete', {'id': book.id}) }}" onsubmit="return confirm('Are you sure you want to delete this book? This action cannot be undone.');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ book.id) }}">
    <button class="btn-action btn-action-delete" style="padding: 0.75rem 1.5rem; font-size: 0.95rem;">Delete Book</button>
</form>
