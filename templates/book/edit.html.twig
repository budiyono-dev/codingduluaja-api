{% extends 'base.html.twig' %}

{% block title %}Edit Book - Libri{% endblock %}

{% block body %}
<div style="max-width: 700px; margin: 0 auto; display: flex; flex-direction: column; gap: 2rem;">
    <div class="glass-panel">
        <h1 style="font-size: 2.25rem;">Edit Book</h1>
        <p class="subtitle">Modify the details of this book below</p>

        {{ include('book/_form.html.twig', {'button_label': 'Update Book'}) }}
    </div>

    <div class="glass-panel" style="border-color: rgba(239, 68, 68, 0.25);">
        <h2 style="font-family: var(--font-heading); font-size: 1.25rem; color: #FCA5A5; margin-bottom: 0.5rem;">Danger Zone</h2>
        <p class="subtitle" style="margin-bottom: 1.5rem; font-size: 0.9rem;">Once you delete a book, it is removed from your catalog forever.</p>
        
        {{ include('book/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}
