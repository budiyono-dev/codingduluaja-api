{% extends 'base.html.twig' %}

{% block title %}Sign In - Libri{% endblock %}

{% block body %}
<div class="auth-panel">
    <div class="glass-panel">
        <div class="auth-header">
            <h1 class="auth-title">Welcome Back</h1>
            <p class="subtitle">Sign in to manage your collection</p>
        </div>

        <form method="post">
            {% if error %}
                <div class="alert-container">
                    <div class="alert-message alert-error">
                        <span>⚠️</span> {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                </div>
            {% endif %}

            <div class="form-group">
                <label for="username" class="form-label">Email Address</label>
                <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" placeholder="name@domain.com" autocomplete="email" required autofocus>
            </div>

            <div class="form-group">
                <label for="password" class="form-label">Password</label>
                <input type="password" name="_password" id="password" class="form-control" placeholder="••••••••" autocomplete="current-password" required>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="form-group" style="margin-top: 2rem; margin-bottom: 0;">
                <button class="btn-submit" type="submit" style="width: 100%;">
                    Sign In
                </button>
            </div>
        </form>

        <div class="auth-footer">
            <p>Don't have an account? <a href="{{ path('app_register') }}">Register here</a></p>
        </div>
    </div>
</div>
{% endblock %}
